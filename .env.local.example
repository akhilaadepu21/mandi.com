# Supabase (get these from `supabase start` for local dev, or your project settings)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: powers the real AI Business Assistant chat in /owner/ai.
# Without this key the AI assistant shows a clear "not configured" state —
# it never fabricates answers.
ANTHROPIC_API_KEY=
